{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(*dvc *)",
      "Bash(*quarto *)",
      "Edit(/.claude/**)",
      "WebSearch",
      "Bash(ls \"/home/haduong/CNRS/projets/actifs/climate-finance-het/tickets/\"*.erg)",
      "Edit(*/.git/hooks/*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(*> /etc/*)",
      "Bash(*git push --force*)",
      "Bash(*git push -f *)",
      "Bash(*git reset --hard*)",
      "Bash(*git clean*)"
    ],
    "additionalDirectories": [
      "/home/haduong/CNRS/html/src",
      "/home/haduong/CNRS/projets/actifs/climate-finance-het/.claude/hooks",
      "/home/haduong/.claude/docs"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "file=$(cat | jq -r '.tool_input.file_path // empty'); case \"$file\" in *.erg) erg check tickets/ 2>&1 ;; esac",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
