#!/bin/sh
# Post-checkout hook for worktrees.
#
# .worktreeinclude copies .env and .dvc/config.local for harness-created
# worktrees. The hook also provisions them below so a plain `git worktree add`
# has the same machine configuration instead of failing only when a gate runs.
#
# This hook wires the worktree to two shared, off-tree resources: the uv
# environment beside the uv cache, and the primary checkout's DVC cache. Both
# are symlinks, so worktree creation stays fast. Bulk DVC data stays on demand
# — populating it eagerly copied ~1.7 GB into every worktree and timed out
# creation. Data is fetched on demand with `make data` (see the Makefile),
# which needs the shared cache below to find anything.

PROJECT_PRIMARY=$(CDPATH= cd -- "$(git rev-parse --git-common-dir)/.." 2>/dev/null && pwd)

initialize_machine_config() (
    # A standalone checkout owns its configuration already. Copy only into a
    # linked worktree, and never overwrite a worktree-local choice.
    [ -f .git ] || exit 0
    CONFIG_SOURCE=${WORKTREE_CONFIG_SOURCE:-$PROJECT_PRIMARY}
    for CONFIG_PATH in .env .dvc/config.local; do
        [ ! -e "$CONFIG_PATH" ] && [ -f "$CONFIG_SOURCE/$CONFIG_PATH" ] || continue
        mkdir -p "$(dirname "$CONFIG_PATH")" || exit 1
        cp -p -- "$CONFIG_SOURCE/$CONFIG_PATH" "$CONFIG_PATH" || exit 1
    done
)
initialize_machine_config || echo 'Worktree machine configuration was not provisioned.' >&2

# Prefer the primary checkout's already validated environment. If it has none,
# co-locate a shared environment with the uv cache on /data.
# uv hardlinks wheels from its cache into the environment, but only when both
# share a filesystem; across filesystems it falls back to copying the whole
# torch closure (~1.8 GB) into every worktree, which is slow enough to exceed
# the worktree tool's timeout and make worktree creation fail outright. The uv
# cache already lives on /data, so we put the environment there too and point
# this worktree's default `.venv` location at it via a symlink. A dangling
# symlink makes `uv run` error, so the shared env is created first. Skipped
# where /data is absent (the default local .venv is then used).
# Only a linked worktree is wired: a primary checkout owns its environment.
# Run there (a switch or fast-forward), this block took the checkout's own
# .venv as the shared env and relinked .venv to itself (2026-09-24).
if [ -f .git ]; then
    PRIMARY_ENV=${WORKTREE_ENV_SOURCE:-$PROJECT_PRIMARY/.venv}
    DATA_ENV=/data/envs/venv/oeconomia
    if [ ! -x "$PRIMARY_ENV/bin/python3" ] && [ -d /data/envs ]; then
        # Create the shared env once. flock serializes the first-ever creation so
        # concurrent worktree checkouts (parallel raids) don't race to build the
        # same path; it is best-effort — without flock the env is still created.
        {
            flock 9 2>/dev/null || true
            [ -d "$DATA_ENV" ] || uv venv "$DATA_ENV" >/dev/null 2>&1 || true
        } 9>/data/envs/.oeconomia-env.lock
    fi
    if [ -x "$PRIMARY_ENV/bin/python3" ]; then
        SHARED_ENV=$PRIMARY_ENV
    else
        SHARED_ENV=$DATA_ENV
    fi
    # Point .venv at a usable shared env when it is absent or a stale symlink;
    # leave a real local .venv directory untouched.
    if [ -x "$SHARED_ENV/bin/python3" ] && { [ ! -e .venv ] || [ -L .venv ]; }; then
        ln -sfn "$SHARED_ENV" .venv 2>/dev/null || true
    fi
fi

# Share the primary checkout's DVC cache.
# `.dvc/` is not tracked wholesale: a worktree gets `config` from git and
# `config.local` from .worktreeinclude, but the cache is gitignored, so a fresh
# worktree starts with an empty private one — and `config.local` carries only
# the remote URL, never cache.dir. `make data` then searches that empty
# cache, fails, and corpus work gets pushed back into the primary
# checkout, losing worktree isolation and the dvc commit/push that goes with a
# normal PR (ticket 0360, after 0347).
#
# Same idiom as .venv above. Sharing the cache is what makes `make data` able to
# find anything at all, and on this machine it costs almost no disk: cache.type
# is unset, so DVC tries its default chain (reflink, then copy) and the repo is
# on btrfs, where a checked-out file shares extents with the cache blob and is
# copied only on write. Verified with filefrag, since differing inodes cannot
# tell reflink from copy. Where the filesystem has no reflink, DVC falls back to
# a real copy and a worktree that runs `make data` spends ~2.2 GB.
#
# Leave cache.type unset, and never set hardlink or symlink. Reflink is safe
# because a write breaks the sharing; a hardlink shares one inode, so any writer
# that opens the target in place writes into the cache blob itself. Phase 1 has
# such a writer: np.savez_compressed() truncates the embeddings .npz directly.
# (The CSV path is safe either way — pipeline_io.save_csv writes a temp file and
# os.replace()s it onto a fresh inode.) A test enforces this, since the setting
# can hide in the gitignored .dvc/config.local.
#
# One consequence to know about: `dvc gc` now reaches every checkout at once. It
# prunes by reachability computed from whichever checkout invokes it, so a stale
# worktree pinned to an old dvc.lock can delete blobs the primary still needs.
# Run it from the primary checkout on a current dvc.lock, or not at all.
#
# The path is derived from the repo rather than hard-coded, so a clone
# elsewhere works. Only ever replace an absent or symlinked .dvc/cache — a
# standalone (non-worktree) checkout owns a real cache directory, and
# clobbering it would orphan every blob in it. Where the cache has been
# relocated with `dvc cache dir <path>`, that setting lands in the git-tracked
# .dvc/config, which a worktree inherits anyway, so this link is simply inert.
#
# stderr is kept (unlike the .venv link above) because the two failures differ
# in consequence: a failed .venv share still leaves a working local env, while a
# failed cache link leaves exactly the empty private cache this exists to
# eliminate. `|| true` still keeps a checkout from failing over it.
SHARED_CACHE=$PROJECT_PRIMARY/.dvc/cache
if [ -d "$SHARED_CACHE" ] && [ "$SHARED_CACHE" != "$(pwd)/.dvc/cache" ] &&
   { [ ! -e .dvc/cache ] || [ -L .dvc/cache ]; }; then
    ln -sfn "$SHARED_CACHE" .dvc/cache || true
fi
